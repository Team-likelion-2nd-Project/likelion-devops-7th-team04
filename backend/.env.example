DB_HOST=mariadb       # 실행되는 mariadb의 호스트명과 동일(docker의 경우 컨테이너 명)
DB_PORT=3306
DB_USERNAME=root      # MARIADB_USER와 동일하게
DB_PASSWORD=password  # MARIADB_PASSWORD와 동일하게
DB_DATABASE=hotel_service

# auth-service가 회원가입 시 발급하는 JWT 서명 secret (운영 환경에서는 반드시 강력한 값으로 교체)
JWT_ACCESS_SECRET=dev-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# auth-service가 리프레시 토큰을 저장하는 Redis (로그아웃 시 삭제 → 재발급 차단)
# 로컬: docker-compose의 redis 컨테이너를 사용 (REDIS_HOST=redis, 인증/TLS 불필요)
# 운영(AWS ElastiCache): REDIS_HOST를 ElastiCache 엔드포인트로, REDIS_PASSWORD를 AUTH 토큰으로,
#   REDIS_TLS=true로 바꾸면 됩니다 (코드 변경 불필요).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# chat-bot-service가 세션/대화 이력을 저장하는 DynamoDB.
# 로컬: docker-compose의 dynamodb-local 컨테이너 (DYNAMODB_ENDPOINT=http://dynamodb-local:8000).
#   AWS_ACCESS_KEY_ID/SECRET은 여기 설정할 필요가 없습니다 — DynamoDB Local은 자격 증명을
#   검증하지 않고, dynamodb.module.ts/dynamodb-init.ts가 값이 없으면 'local'로 기본값을
#   채우도록 이미 짜여 있습니다.
# 운영(AWS DynamoDB): DYNAMODB_ENDPOINT를 비우면 EKS pod identity(chatbot_service IAM 역할)로
#   인증됩니다 (코드 변경 불필요).
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_REGION=ap-northeast-2

# chat-bot-service가 AI 처리를 위임하는 n8n workflow의 webhook 주소.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat
N8N_TIMEOUT_MS=30000

# db-seed 서비스(scripts/seed.ts)가 docker compose 최초 기동 시 1회 생성하는 관리자 계정.
# Swagger에서 POST /api/auth/admin/login 테스트 시 아래 평문 비밀번호를 그대로 입력하면 됩니다
# (admin_credentials에는 해시만 저장되고 평문은 여기 .env에만 남습니다. 이미 계정이 있으면 건너뜁니다).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=관리자