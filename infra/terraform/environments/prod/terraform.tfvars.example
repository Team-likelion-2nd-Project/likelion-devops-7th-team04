alarm_email = "your-email@example.com"
db_root_password = "REPLACE_ME"
team_member_arns = [
  "arn:aws:iam::<ACCOUNT_ID>:user/<username>"
]

# backend/.env.example의 SEED_ADMIN_*와 동일한 역할 — mariadb user_data가
# backend/scripts/seed.ts를 실행할 때 그대로 넘겨받는다.
seed_admin_email    = "admin@example.com"
seed_admin_password = "REPLACE_ME"
seed_admin_name     = "관리자"

# CloudFront alias 도메인 / ACM 인증서 도메인. dev/prod가 서로 다른 서브도메인을 쓰므로
# 환경별로 여기서만 값이 갈린다 — main.tf엔 값이 전혀 없다. 실제 DNS(kro.kr) CNAME 등록은
# Terraform 밖에서 별도로 해야 한다. prod는 기존 서비스 도메인을 그대로 계승한다.
domain_name = "www.team04hotel.kro.kr"
certificate_domain = "*.team04hotel.kro.kr"